{
  "extends": "@repo/typescript/library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "strictNullChecks": true,
    "paths": {
      "@repo/ui-w/*": ["./*"]
    }
  },
  "include": [
    "shared",
    "lib",
    "styles",
    "hooks",
    "providers",
    "contexts",
    "constants",
    "helpers",
    "types"
  ],
  "exclude": ["node_modules", "dist"]
}
