# Application
PORT="36081"
ENVIRONMENT="development"
DEBUG=""

# Relational Database
RL_DB_URL=""

# BetterAuth
AUTH_ALLOW_EMAIL_SIGN_UP="false"
BETTER_AUTH_URL="http://localhost:36081"
BETTER_AUTH_SECRET=""
# Leave empty locally; production uses the narrow parent domain shared by the apps.
BETTER_AUTH_COOKIE_DOMAIN=""

# Internal Service Authentication
# Use the same 32+ character token in apps/api/.env.
AUTH_SERVICE_TOKEN=""

# CORS
# Keep browser origins exact; credentials are required for BetterAuth session cookies.
# Origins, methods, and header names are comma-separated; credentials is "true" or "false".
CORS_ALLOWED_ORIGINS="http://localhost:36000,http://localhost:36002"
CORS_ALLOWED_METHODS="GET,POST,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,Authorization"
CORS_EXPOSE_HEADERS=""
CORS_ALLOW_CREDENTIALS="true"

# Cloudflare
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare Email Service
WELCOME_EMAIL=""
INVITATION_EMAIL=""

# Platform URL
PLATFORM_BASE_URL=""
