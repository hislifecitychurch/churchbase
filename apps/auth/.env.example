# Application
PORT="36081"
ENVIRONMENT="development"
DEBUG=""

# Relational Database
RL_DB_URL="postgres://churchbase:local-dev-only@127.0.0.1:5432/churchbase?sslmode=disable"

# BetterAuth
AUTH_ALLOW_EMAIL_SIGN_UP="false"
BETTER_AUTH_URL="http://localhost:36081"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_COOKIE_DOMAIN=""

# Internal Service Authentication
API_BASE_URL=""
AUTH_SERVICE_TOKEN=""

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:36002"
CORS_ALLOWED_METHODS=""
CORS_ALLOWED_HEADERS=""
CORS_EXPOSE_HEADERS=""
CORS_ALLOW_CREDENTIALS=""

# Cloudflare
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare Email Delivery
WELCOME_EMAIL=""
INVITATION_EMAIL=""

# Platform URL
PLATFORM_BASE_URL=""
