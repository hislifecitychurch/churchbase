{
  "name": "auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "db:migrate": "bun run db/migrate.ts",
    "build": "bun run check-types",
    "lint": "bun run check-types",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "1.7.16",
    "hono": "4.13.7",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@packages/typescript": "*",
    "@types/pg": "^8.23.1",
    "bun-types": "1.4.2",
    "typescript": "7.0.2"
  }
}
