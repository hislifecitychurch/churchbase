# Application
ENVIRONMENT=""
PORT="36080"
DEBUG=""

# Relational Database
RL_DB_URL="postgres://churchbase:local-dev-only@127.0.0.1:5432/churchbase?sslmode=disable"

# KV Database
KV_DB_URL="redis://127.0.0.1:6379/0"

# Internal Service Authentication Configuration
AUTH_BASE_URL=""
AUTH_SERVICE_TOKEN=""

# Rate Limit
RATE_LIMIT_READ_REQUESTS=""
RATE_LIMIT_WRITE_REQUESTS=""
RATE_LIMIT_INTERNAL_REQUESTS=""
RATE_LIMIT_WINDOW_SECONDS=""

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:36002"
CORS_ALLOWED_METHODS=""
CORS_ALLOWED_HEADERS=""
CORS_EXPOSE_HEADERS=""
CORS_ALLOW_CREDENTIALS=""

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Local Compose dependencies
POSTGRES_USER="churchbase"
POSTGRES_PASSWORD="local-dev-only"
POSTGRES_DB="churchbase"
POSTGRES_PORT="5432"
REDIS_PORT="6379"
