{
  "extends": "@packages/typescript/nextjs.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node", "vinext/types"],
    "paths": {
      "@/*": ["./*"],
      "@packages/ui-w/*": ["../../packages/ui-w/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".cloudflare/types"
  ],
  "exclude": ["node_modules"]
}
