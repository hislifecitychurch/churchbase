# BetterAuth
NEXT_PUBLIC_AUTH_URL="http://localhost:36081"

# API role lookup
NEXT_PUBLIC_API_URL_V1="http://localhost:36080/api/v1"

# Frontend destinations
NEXT_PUBLIC_PLATFORM_URL="http://localhost:36001"

# Return URL safety
# Use comma-separated exact frontend origins; Identity only redirects to these origins.
NEXT_PUBLIC_IDENTITY_ALLOWED_RETURN_ORIGINS="http://localhost:36002,http://localhost:36001"
NEXT_PUBLIC_IDENTITY_DEFAULT_RETURN_URL="http://localhost:36002/"
